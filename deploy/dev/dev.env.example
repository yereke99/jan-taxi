# Local development settings for `make dev-api`, `make dev-bots` and
# `make devlink` (processes run with `go run` on the host, the database in the
# local PostGIS container from `make test-db-up`).
#
#   cp deploy/dev/dev.env.example .env.dev
#
# Every value here is for a developer machine only. Never reuse these secrets
# or placeholder tokens anywhere else.

APP_ENV=development
DATABASE_URL=postgres://jantaxi:jantaxi@localhost:55432/jantaxi?sslmode=disable
LOG_LEVEL=debug
LOG_FORMAT=text

# Mini Apps without Telegram: `make devlink` signs initData with these tokens
# and the API validates it with the same tokens. They are well-formed
# placeholders, not real bots, so the notification worker is off (it would only
# collect Telegram errors). To run the bots or send notifications, create test
# bots in @BotFather, put their tokens and usernames here and set
# NOTIFICATION_WORKER_ENABLED=true.
PASSENGER_BOT_TOKEN=1000000001:DEVONLY_passenger_placeholder_token
DRIVER_BOT_TOKEN=1000000002:DEVONLY_driver_placeholder_token_x
PASSENGER_BOT_USERNAME=example_passenger_bot
DRIVER_BOT_USERNAME=example_driver_bot
NOTIFICATION_WORKER_ENABLED=false
JOBS_ENABLED=true

# Vite dev servers (pnpm dev in each app) proxy /api to the API on :8080.
PASSENGER_MINIAPP_URL=http://localhost:5173/passenger/
DRIVER_MINIAPP_URL=http://localhost:5174/driver/
ADMIN_FRONTEND_URL=http://localhost:5175/
API_PUBLIC_URL=http://localhost:8080
ADMIN_COOKIE_SECURE=false

# Fixed so the bots (separate processes) can call the internal API.
SESSION_SECRET=devonly-session-secret-0123456789abcdef
INTERNAL_BOT_SERVICE_SECRET=devonly-service-secret-0123456789abcdef
INTERNAL_API_URL=http://localhost:8081

FILE_STORAGE_DIR=./data/files

# Routing: `make dev-osrm` serves the dataset built by `make osrm-prepare`.
OSRM_BASE_URL=http://localhost:5000
# Geocoding through the public Photon instance (fair use, development only).
GEOCODING_PROVIDER=photon

DEFAULT_CITY=EMB
DEFAULT_LANGUAGE=kk
MAX_ROUTE_POINTS=5
DEFAULT_COMMISSION_PERCENT=10
