# Jan Taxi production configuration template.
#
#   cp .env.example .env && chmod 600 .env
#
# Fill in every value marked REQUIRED and replace every placeholder, then run
# `sh deploy/preflight.sh .env` (`make up` runs it too). Never commit .env.
# Generate secrets with:  openssl rand -hex 32
# Values with spaces must be quoted. Do not use "$" in values (Compose would
# try to interpolate it).
#
# For local development with `go run` use deploy/dev/dev.env.example instead
# (copied to .env.dev); this file describes the Docker Compose deployment.

# ---------------------------------------------------------------------------
# Docker Compose
# ---------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=jantaxi
# Optional services to start with `make up`: osrm (route previews; needs
# `make osrm-prepare` once), geocoder (self-hosted Photon). Comma-separated.
COMPOSE_PROFILES=osrm
# Image names: <IMAGE_REGISTRY>/api:<IMAGE_TAG>. Tag every release (for example
# with the git commit) so a rollback is `IMAGE_TAG=<previous> make up`.
IMAGE_REGISTRY=jantaxi
IMAGE_TAG=latest
# Docker json-file log rotation for every service.
LOG_MAX_SIZE=20m
LOG_MAX_FILE=5

# ---------------------------------------------------------------------------
# Domains and TLS (Caddy)
# ---------------------------------------------------------------------------
# REQUIRED. Replace the *.jantaxi.example placeholders with your real names.
# DNS A/AAAA records of both names must point at this server before the first
# start, so Caddy can obtain certificates.
APP_DOMAIN=app.jantaxi.example
ADMIN_DOMAIN=admin.jantaxi.example
# REQUIRED. Contact address for the ACME certificate authority.
ACME_EMAIL=ops@jantaxi.example
HTTP_PORT=80
HTTPS_PORT=443
# Extra Caddy global options. Empty in production. Local edge without TLS:
#   APP_DOMAIN=http://localhost:8088  ADMIN_DOMAIN=http://localhost:8089
#   CADDY_GLOBAL_OPTIONS="auto_https off"
CADDY_GLOBAL_OPTIONS=
# Origins the browser may fetch map styles, tiles, glyphs and sprites from
# (Content-Security-Policy connect-src). Must cover MAP_STYLE_URL's hosts.
MAP_CONNECT_SRC=https://tiles.openfreemap.org

# ---------------------------------------------------------------------------
# PostgreSQL + PostGIS
# ---------------------------------------------------------------------------
# Apple Silicon development: POSTGIS_IMAGE=imresamu/postgis:17-3.5-alpine
POSTGIS_IMAGE=postgis/postgis:17-3.5
POSTGRES_USER=jantaxi
# REQUIRED. Replace the placeholder; URL-safe characters only (it is embedded
# in DATABASE_URL):  openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_24
POSTGRES_DB=jantaxi
# Containers get DATABASE_URL from compose.yaml (built from POSTGRES_* with
# host "db"). Set it here only for tools run outside Compose.
DATABASE_URL=
DATABASE_MAX_CONNS=25
# Server tuning (defaults suit the 2 GB DB_MEM_LIMIT below; raise together).
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE_SIZE=1536MB
PG_MAX_CONNECTIONS=100
PG_LOG_MIN_DURATION_MS=1000
# Container limits (memory and CPUs) of the database and the API.
DB_MEM_LIMIT=2g
DB_CPUS=2
API_MEM_LIMIT=1g
API_CPUS=2

# ---------------------------------------------------------------------------
# Backups (db-backup service)
# ---------------------------------------------------------------------------
# Daily pg_dump + archive of the private file volume into BACKUP_HOST_DIR.
# Copy that directory to a second server located in Kazakhstan
# (docs/OPERATIONS.md); a backup on the same disk is not a backup.
BACKUP_HOST_DIR=./backups
BACKUP_RETENTION_DAYS=14
BACKUP_TIME=03:30
# A failed run is retried after this many minutes.
BACKUP_RETRY_MINUTES=60
BACKUP_TZ=Asia/Aqtobe
# Numeric uid:gid that should own the backup files, so a non-root user (for
# example the deploy user running the off-site copy) can read them. Find it
# with `id -u` and `id -g`. Empty = owned by root.
BACKUP_OWNER=
# Client major version must match the server (PostgreSQL 17).
BACKUP_IMAGE=postgres:17-alpine

# ---------------------------------------------------------------------------
# API runtime
# ---------------------------------------------------------------------------
# production | development | test. Production enforces https URLs, real bot
# tokens, long secrets and Secure admin cookies.
APP_ENV=production
# Ports and the file directory are fixed by compose.yaml (see the last section).
MAX_UPLOAD_BYTES=10485760
LOG_LEVEL=info
LOG_FORMAT=json
# Background jobs and the Telegram notification worker. Keep both true on
# exactly the replicas that should run them (jobs also take advisory locks).
NOTIFICATION_WORKER_ENABLED=true
JOBS_ENABLED=true
# Reverse proxies whose X-Forwarded-For is trusted. Empty = private networks
# (Caddy on the Docker network). "none" disables proxy trust.
TRUSTED_PROXIES=
# Extra browser origins allowed by CORS, comma-separated, https only. The Mini
# App and admin URLs below are always allowed. Usually empty.
CORS_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Telegram bots (two separate bots created in @BotFather)
# ---------------------------------------------------------------------------
# REQUIRED. Tokens from @BotFather; the two bots must be different.
PASSENGER_BOT_TOKEN=
DRIVER_BOT_TOKEN=
# REQUIRED. Bot usernames without "@", ending in "bot".
PASSENGER_BOT_USERNAME=
DRIVER_BOT_USERNAME=
# Optional short names of named Mini Apps (/newapp). Empty = each bot's Main
# Mini App (recommended, docs/TELEGRAM_SETUP.md).
PASSENGER_MINIAPP_SHORT_NAME=
DRIVER_MINIAPP_SHORT_NAME=
TELEGRAM_API_BASE_URL=https://api.telegram.org
# Maximum age of Mini App initData accepted at sign-in.
TELEGRAM_INITDATA_MAX_AGE=24h

# ---------------------------------------------------------------------------
# Public URLs (https in production; must match APP_DOMAIN / ADMIN_DOMAIN)
# ---------------------------------------------------------------------------
PASSENGER_MINIAPP_URL=https://app.jantaxi.example/passenger/
DRIVER_MINIAPP_URL=https://app.jantaxi.example/driver/
ADMIN_FRONTEND_URL=https://admin.jantaxi.example/
API_PUBLIC_URL=https://app.jantaxi.example

# ---------------------------------------------------------------------------
# Secrets and sessions
# ---------------------------------------------------------------------------
# REQUIRED. At least 32 bytes each and different from each other:
#   openssl rand -hex 32
# SESSION_SECRET signs Mini App tokens and admin CSRF tokens.
SESSION_SECRET=
# Shared by the API's internal listener and both bots.
INTERNAL_BOT_SERVICE_SECRET=
APP_TOKEN_TTL=12h
ADMIN_SESSION_IDLE_TTL=12h
ADMIN_SESSION_ABSOLUTE_TTL=168h
ADMIN_COOKIE_SECURE=true
# One-time bootstrap of the first super admin when no admin exists yet. Set
# both (password 12+ characters), start once, then remove both lines. The
# preferred way is `make admin-create`, which reads the password from stdin.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# ---------------------------------------------------------------------------
# Kaspi Pay (manual top-up verification; docs/OPERATIONS.md)
# ---------------------------------------------------------------------------
# The Kaspi Pay payment link of the merchant's sales point, the recipient name
# drivers see, and short payment instructions. These are defaults; admins can
# override them in the admin panel settings. Without them drivers see no
# payment details for top-ups.
KASPI_PAY_PAYMENT_URL=
KASPI_PAY_RECIPIENT_NAME=
KASPI_PAY_PAYMENT_INSTRUCTIONS=

# ---------------------------------------------------------------------------
# Maps, routing and geocoding
# ---------------------------------------------------------------------------
# MapLibre style for the Mini Apps (OpenFreeMap Positron: free, attribution
# required). Keep MAP_CONNECT_SRC in sync when changing provider.
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
MAP_API_KEY=
# OSRM router (compose profile "osrm").
OSRM_BASE_URL=http://osrm:5000
OSRM_TIMEOUT=5s
OSRM_IMAGE=ghcr.io/project-osrm/osrm-backend:v26.10.0-debian
OSRM_PBF_URL=https://download.geofabrik.de/asia/kazakhstan-latest.osm.pbf
# Set to 1 only for a mirror that publishes no .md5 checksum next to the file.
OSRM_SKIP_MD5=0
OSRM_MEM_LIMIT=3g
OSRM_CPUS=2
OSRM_PREPARE_MEM_LIMIT=6g
# Small image used by the one-shot download step (wget, md5sum).
DOWNLOAD_IMAGE=alpine:3.22
# Geocoder: photon | nominatim | twogis | none. Empty GEOCODING_BASE_URL uses
# the provider's public endpoint (photon: https://photon.komoot.io, fair use
# only). Production: self-hosted Photon (profile "geocoder") with
# GEOCODING_BASE_URL=http://photon:2322, or twogis with GEOCODING_API_KEY.
GEOCODING_PROVIDER=photon
GEOCODING_BASE_URL=
GEOCODING_API_KEY=
# Self-hosted Photon (profiles geocoder / geocoder-import).
PHOTON_VERSION=1.3.0
PHOTON_DUMP_URL=https://download1.graphhopper.com/public/asia/central-asia/photon-dump-central-asia-1.0-latest.jsonl.zst
PHOTON_COUNTRY_CODES=kz
PHOTON_LANGUAGES=
PHOTON_JAVA_OPTS=-Xmx1g
PHOTON_MEM_LIMIT=2g
PHOTON_IMPORT_MEM_LIMIT=4g
# Extra flags for `photon serve` (for example -max-results 10). Usually empty.
PHOTON_SERVE_ARGS=
# Base URL of 2GIS links that open driver navigation.
TWOGIS_BASE_URL=https://2gis.ru

# ---------------------------------------------------------------------------
# Product defaults (runtime-editable ones can be overridden in the admin panel)
# ---------------------------------------------------------------------------
DEFAULT_CITY=EMB
DEFAULT_LANGUAGE=kk
# Pickup + stops + destination, 2..5.
MAX_ROUTE_POINTS=5
# Platform commission on the fare, percent (10 = 10%).
DEFAULT_COMMISSION_PERCENT=10
# Drivers without a heartbeat or location for this long are set offline.
DRIVER_ONLINE_IDLE_TIMEOUT=12h

# ---------------------------------------------------------------------------
# Fixed by compose.yaml inside the containers. Listed for completeness:
# Compose ignores these lines and always uses the values shown here.
# ---------------------------------------------------------------------------
# API listeners: public REST + WebSocket and the internal bot API.
API_PORT=8080
INTERNAL_PORT=8081
# Private file volume of the api container.
FILE_STORAGE_DIR=/data/files
# Bots: internal API address, health port and lease holder id (empty = the
# container hostname, unique per container).
INTERNAL_API_URL=http://api:8081
HEALTH_PORT=8090
INSTANCE_ID=
