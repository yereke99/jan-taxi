{
  "name": "@jantaxi/driver-miniapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode demo",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "build:demo": "vue-tsc --noEmit -p tsconfig.app.json && vite build --mode demo --outDir dist-demo",
    "preview": "vite preview",
    "preview:demo": "vite preview --outDir dist-demo",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "lint": "node scripts/lint.mjs"
  },
  "dependencies": {
    "@lucide/vue": "1.58.0",
    "@tma.js/sdk": "3.3.0",
    "@tma.js/sdk-vue": "1.0.23",
    "maplibre-gl": "6.14.0",
    "pinia": "4.1.0",
    "vue": "3.5.44",
    "vue-i18n": "11.4.14",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  }
}
