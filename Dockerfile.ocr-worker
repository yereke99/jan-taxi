FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY admin/backend ./admin/backend
RUN CGO_ENABLED=0 go build -trimpath -o /out/ocr-worker ./admin/backend/cmd/ocr-worker

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates python3 python3-venv tesseract-ocr tesseract-ocr-kaz tesseract-ocr-rus tesseract-ocr-eng poppler-utils && rm -rf /var/lib/apt/lists/* && groupadd -g 65532 worker && useradd -u 65532 -g 65532 -M -r worker
COPY deploy/ocr/requirements.txt deploy/ocr/download_models.py /opt/jantaxi/ocr/
RUN python3 -m venv /opt/ocr-env && /opt/ocr-env/bin/pip install --no-cache-dir --disable-pip-version-check -r /opt/jantaxi/ocr/requirements.txt && python3 /opt/jantaxi/ocr/download_models.py
COPY deploy/ocr /opt/jantaxi/ocr
COPY --from=build /out/ocr-worker /usr/local/bin/ocr-worker
ENV PATH="/opt/ocr-env/bin:$PATH" OMP_THREAD_LIMIT=1 OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 PYTHONDONTWRITEBYTECODE=1
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/ocr-worker"]
