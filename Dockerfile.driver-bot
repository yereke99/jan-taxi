# syntax=docker/dockerfile:1.7
#
# Jan Taxi driver bot: Telegram long polling, talks only to api:8081.
# Health endpoint on :8090 (HEALTH_PORT).
#
#   docker build -f Dockerfile.driver-bot -t jantaxi/driver-bot .

ARG GO_IMAGE=golang:1.26-alpine
ARG RUNTIME_IMAGE=gcr.io/distroless/static-debian12:nonroot

FROM ${GO_IMAGE} AS build
WORKDIR /src
ENV CGO_ENABLED=0 \
    GOTOOLCHAIN=local \
    GOFLAGS=-buildvcs=false

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

# Bots may import only the public client packages under admin/backend/pkg.
COPY admin/backend/pkg ./admin/backend/pkg
COPY driver/bot ./driver/bot
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go build -trimpath -ldflags "-s -w" -o /out/driver-bot ./driver/bot/cmd

FROM ${RUNTIME_IMAGE}
COPY --from=build /out/driver-bot /usr/local/bin/driver-bot
USER nonroot:nonroot
ENV HEALTH_PORT=8090
EXPOSE 8090
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD ["/usr/local/bin/driver-bot", "healthcheck"]
ENTRYPOINT ["/usr/local/bin/driver-bot"]
